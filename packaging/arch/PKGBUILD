# Maintainer: coderosh
pkgname=unreal-version-manager
pkgver=0.1.0
pkgrel=1
pkgdesc="Small GUI to install, launch and switch Unreal Engine versions on Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/coderosh/unreal-version-manager"
license=('MIT')
depends=(
  'hicolor-icon-theme'
  'libgcc'
  'glibc'
  'libglvnd'          # OpenGL/EGL for the egui renderer
  'libxkbcommon'
  'wayland'
  'xdg-desktop-portal' # native file pickers
  'xdg-utils'          # xdg-open for "Get versions…" and "Open folder"
)
optdepends=(
  'libx11: X11 session support'
  'libxcursor: X11 session support'
  'libxrandr: X11 session support'
  'libxi: X11 session support'
)
makedepends=('cargo')
options=('!lto' '!debug') # binary is already stripped by Cargo.toml
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # run `updpkgsums` after tagging v$pkgver

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "assets/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 "assets/$pkgname.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
